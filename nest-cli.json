{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/my-blog/src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "monorepo": true,
  "root": "apps/my-blog",
  "defaultProject": "my-blog",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "my-blog": {
      "type": "application",
      "root": "apps/my-blog",
      "entryFile": "main",
      "sourceRoot": "apps/my-blog/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-blog/tsconfig.app.json"
      }
    },
    "my-admin": {
      "type": "application",
      "root": "apps/my-admin",
      "entryFile": "main",
      "sourceRoot": "apps/my-admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-admin/tsconfig.app.json"
      }
    },
    "repository": {
      "type": "library",
      "root": "libs/repository",
      "entryFile": "index",
      "sourceRoot": "libs/repository/src",
      "compilerOptions": {
        "tsConfigPath": "libs/repository/tsconfig.lib.json"
      }
    }
  }
}